import greenfoot.*;  // (World, Actor, GreenfootImage, Greenfoot and MouseInfo)

/**
 *Monster actor moves to edge of screen before being removed
 * 
 * Carter Arnold
 * 11/13/2026
 */
public class Monster extends Actor
{
    /**
     * Act - do whatever the Monster wants to do. This method is called whenever
     * the 'Act' or 'Run' button gets pressed in the environment.
     */
    Scoreboard score = DragonsDen.getScore();
    boolean shouldMove = false;
    public void act()
    {
        setRotation(90);
        if (isAtEdge()) {
            shouldMove = false;
            setLocation(getX(), 25);
            score.addScore(1);
        }
        if (shouldMove == true) {
            move(5);
        }
    }
    public void move() {
        shouldMove = true;
    }
}
